# Copy to `.env` and fill in real values. Never commit `.env`.

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=Ov23liBF7M1dZT1voEco
GITHUB_CLIENT_SECRET=f2e065752205addf86aa81e24032e5b44f50f2e4

# Frontend origin (CORS) and the backend URL used for OAuth redirects.
# The backend reads FRONTEND_URL; VITE_API_URL is the frontend's copy of the
# backend base URL (kept here so the two stay in sync during local dev).
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
BACKEND_BASE=http://localhost:8000

# Comma-separated emails promoted to super_admin on login/register.
# CODEATLAS_SUPER_ADMIN=

# Postgres storage (Supabase / Render Postgres / Neon). When unset the backend
# falls back to JSON files under data_base/.
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Optional: Fernet key used to encrypt GitHub OAuth tokens at rest. When unset
# a key is generated once and stored in the DB (.secret_key in file mode).
# CODEATLAS_SECRET_KEY=
